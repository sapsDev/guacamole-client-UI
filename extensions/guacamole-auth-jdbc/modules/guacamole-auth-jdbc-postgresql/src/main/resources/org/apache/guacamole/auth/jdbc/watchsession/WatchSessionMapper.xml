<mapper namespace="org.apache.guacamole.auth.jdbc.watchsession.WatchSessionMapper">

    <!-- Result mapper for watch session objects -->
    <resultMap id="WatchSessionResultMap" type="org.apache.guacamole.auth.jdbc.watchsession.WatchSessionModel">

        <!-- Watch session properties -->
        <id     column="watch_session_id" property="objectID"    jdbcType="INTEGER"/>
        <result column="username"         property="username"    jdbcType="VARCHAR"/>
        <result column="connection"       property="connection"  jdbcType="VARCHAR"/>
        <result column="uuid"             property="uuid"        jdbcType="VARCHAR"/>
        <result column="restriction"      property="restriction" jdbcType="BOOLEAN"/>
        <result column="link"             property="link"        jdbcType="VARCHAR"/>
        
    </resultMap>

    <!-- Select all watch session identifiers -->
    <select id="selectIdentifiers" resultType="string">
        SELECT watch_session_id 
        FROM guacamole_watch_session
    </select>

    <!-- Select multiple watch sessions by identifier -->
    <select id="select" resultMap="WatchSessionResultMap">
        
        SELECT 
            watch_session_id, 
            username, 
            uuid,
            connection,    
            restriction, 
            link
        FROM guacamole_watch_session
        WHERE watch_session_id IN
        <foreach collection="identifiers" item="identifier" 
                 open="(" separator="," close=")">
            #{identifier,jdbcType=INTEGER}::integer
        </foreach>;
        
    </select>

    <!-- Delete single watch session by identifier -->
    <delete id="delete">
        DELETE FROM guacamole_watch_session
        WHERE watch_session_id = #{identifier,jdbcType=INTEGER}::integer
    </delete>

    <!-- Delete single watch session by tunnel uuid -->
    <delete id="deleteOneByUuid">
        DELETE FROM guacamole_watch_session
        WHERE uuid = #{uuid,jdbcType=VARCHAR}
    </delete>

    <!-- Insert single watch session -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="object.objectID"
            parameterType="org.apache.guacamole.auth.jdbc.watchsession.WatchSessionModel">
        
        INSERT INTO guacamole_watch_session (
            username,
            connection,  
            uuid,
            restriction, 
            link
        )
        VALUES (
            #{object.username,jdbcType=VARCHAR},
            #{object.connection,jdbcType=VARCHAR},
            #{object.uuid,jdbcType=VARCHAR},
            #{object.restriction,jdbcType=BOOLEAN},
            #{object.link,jdbcType=VARCHAR}
        )
        
    </insert>
    
    <!-- Update single watch session -->
    <update id="update" parameterType="org.apache.guacamole.auth.jdbc.watchsession.WatchSessionModel">
        UPDATE guacamole_watch_session
        SET username = #{object.username,jdbcType=VARCHAR},
            connection = #{object.connection,jdbcType=VARCHAR},
            uuid = #{object.uuid,jdbcType=VARCHAR},
            restriction = #{object.restriction,jdbcType=BOOLEAN},
            link = #{object.link,jdbcType=VARCHAR}
        WHERE watch_session_id = #{object.objectID,jdbcType=INTEGER}::integer
    </update>

    <!-- Delete attributes (required by ModeledDirectoryObjectMapper) -->
    <delete id="deleteAttributes">
        <!-- No attributes to delete, so this is effectively a no-op -->
        SELECT 0
    </delete>

    <!-- Insert attributes (required by ModeledDirectoryObjectMapper) -->
    <insert id="insertAttributes" parameterType="org.apache.guacamole.auth.jdbc.base.ArbitraryAttributeModel">
        <!-- No attributes to insert, so this is effectively a no-op -->
        SELECT 0
    </insert>

</mapper>
